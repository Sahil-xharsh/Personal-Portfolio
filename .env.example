# Sanity frontend configuration
VITE_SANITY_PROJECT_ID="your-sanity-project-id"
VITE_SANITY_DATASET="production"
VITE_SANITY_API_VERSION="2025-01-01"

# Optional. If your dataset is private, use a read-only token only.
# Never put a Sanity write token in a VITE_* variable.
VITE_SANITY_READ_TOKEN="your-read-only-sanity-token"

# Cloudinary image hosting
VITE_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# Existing app variables
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="http://localhost:3000"
